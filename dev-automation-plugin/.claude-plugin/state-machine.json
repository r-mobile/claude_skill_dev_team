{
  "version": "1.0.0",
  "description": "State Machine для управления жизненным циклом разработки мобильного приложения",
  "states": {
    "INIT": {
      "name": "Инициализация",
      "description": "Получение входных данных и выбор режима",
      "transitions": ["ANALYSIS"],
      "timeout_seconds": 300,
      "checkpoint": true,
      "rollback_safe": true,
      "data_requirements": {
        "user_description": "string",
        "platforms": "array",
        "mode": "enum(standard|premium)"
      }
    },
    "ANALYSIS": {
      "name": "Анализ требований",
      "description": "Analyzer преобразует описание в подробное ТЗ",
      "transitions": ["VALIDATION_ANALYSIS", "ERROR"],
      "timeout_seconds": 3600,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "analyzer",
      "outputs": {
        "specification": "markdown",
        "specification_json": "json",
        "user_stories": "array",
        "requirements": "object"
      }
    },
    "VALIDATION_ANALYSIS": {
      "name": "Валидация ТЗ",
      "description": "Проверка корректности созданного ТЗ",
      "transitions": ["ARCHITECTURE", "ANALYSIS"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "has_functional_requirements": true,
        "has_non_functional_requirements": true,
        "user_stories_count_min": 3,
        "requirements_completeness": 0.8
      }
    },
    "ARCHITECTURE": {
      "name": "Проектирование архитектуры",
      "description": "Architect проектирует архитектуру на основе ТЗ",
      "transitions": ["VALIDATION_ARCHITECTURE", "ERROR"],
      "timeout_seconds": 3600,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "architect",
      "inputs": {
        "specification": "from_ANALYSIS.specification_json",
        "mode": "from_INIT.mode"
      },
      "outputs": {
        "architecture_diagram": "markdown",
        "components": "object",
        "api_contracts": "object",
        "data_models": "object"
      }
    },
    "VALIDATION_ARCHITECTURE": {
      "name": "Валидация архитектуры",
      "description": "Проверка корректности архитектурного дизайна",
      "transitions": ["PLANNING", "ARCHITECTURE"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "has_component_description": true,
        "has_api_contracts": true,
        "has_data_models": true,
        "dependency_validation": true,
        "compliance_with_specification": 0.9
      }
    },
    "PLANNING": {
      "name": "Планирование разработки",
      "description": "Dev-Lead разбивает на задачи и рассчитывает разработчиков",
      "transitions": ["VALIDATION_PLANNING", "ERROR"],
      "timeout_seconds": 1800,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "dev-lead",
      "inputs": {
        "architecture": "from_ARCHITECTURE.architecture_diagram",
        "specification": "from_ANALYSIS.specification_json",
        "mode": "from_INIT.mode"
      },
      "outputs": {
        "developer_count": "integer(1-10)",
        "tasks": "array",
        "task_distribution": "object",
        "dependency_graph": "object",
        "focused_requirements": "object"
      }
    },
    "VALIDATION_PLANNING": {
      "name": "Валидация плана",
      "description": "Проверка корректности распределения задач",
      "transitions": ["INTERACTIVE_DEV", "PLANNING"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "developer_count_valid": "1-10",
        "all_tasks_assigned": true,
        "no_conflicts_in_assignment": true,
        "dependencies_valid": true,
        "task_distribution_balanced": 0.7
      }
    },
    "INTERACTIVE_DEV": {
      "name": "Интерактивная разработка",
      "description": "Task-Orchestrator управляет N Developer skills параллельно",
      "transitions": ["INTEGRATION", "ERROR"],
      "timeout_seconds": 28800,
      "checkpoint": true,
      "rollback_safe": false,
      "agent": "task-orchestrator",
      "inputs": {
        "developer_count": "from_PLANNING.developer_count",
        "tasks": "from_PLANNING.tasks",
        "focused_requirements": "from_PLANNING.focused_requirements",
        "api_contracts": "from_ARCHITECTURE.api_contracts"
      },
      "outputs": {
        "code_from_developers": "object",
        "developer_questions": "array",
        "development_progress": "object"
      },
      "context_optimization": {
        "max_context_per_developer_kb": 10,
        "async_questions": true,
        "incremental_results": true
      }
    },
    "INTEGRATION": {
      "name": "Интеграция кода",
      "description": "Integrator объединяет код от всех разработчиков",
      "transitions": ["VALIDATION_INTEGRATION", "ERROR"],
      "timeout_seconds": 3600,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "integrator",
      "inputs": {
        "code_from_developers": "from_INTERACTIVE_DEV.code_from_developers",
        "api_contracts": "from_ARCHITECTURE.api_contracts",
        "dependency_graph": "from_PLANNING.dependency_graph"
      },
      "outputs": {
        "integrated_code": "full_project",
        "conflict_resolutions": "array",
        "integration_report": "markdown"
      },
      "incremental_mode": true
    },
    "VALIDATION_INTEGRATION": {
      "name": "Валидация интеграции",
      "description": "Проверка что код скомпилирован и структурирован правильно",
      "transitions": ["REVIEW", "INTEGRATION"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "code_compiles": true,
        "no_syntax_errors": true,
        "all_files_present": true,
        "project_structure_valid": true
      }
    },
    "REVIEW": {
      "name": "Code Review",
      "description": "Code-Reviewer проверяет качество интегрированного кода",
      "transitions": ["VALIDATION_REVIEW", "ERROR"],
      "timeout_seconds": 3600,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "code-reviewer",
      "inputs": {
        "integrated_code": "from_INTEGRATION.integrated_code",
        "architecture": "from_ARCHITECTURE.architecture_diagram",
        "mode": "from_INIT.mode"
      },
      "outputs": {
        "review_report": "markdown",
        "issues_found": "object",
        "readiness_assessment": "object"
      }
    },
    "VALIDATION_REVIEW": {
      "name": "Валидация review",
      "description": "Проверка что критичные проблемы найдены и задокументированы",
      "transitions": ["TESTING", "REVIEW"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "critical_issues_documented": true,
        "recommendations_specific": true,
        "readiness_clear": true
      }
    },
    "TESTING": {
      "name": "Тестирование",
      "description": "Tester проверяет компиляцию и базовый функционал",
      "transitions": ["VALIDATION_TESTING", "ERROR"],
      "timeout_seconds": 3600,
      "checkpoint": true,
      "rollback_safe": true,
      "skill": "tester",
      "inputs": {
        "integrated_code": "from_INTEGRATION.integrated_code",
        "requirements": "from_ANALYSIS.requirements"
      },
      "outputs": {
        "test_report": "markdown",
        "compilation_status": "string",
        "functional_test_results": "object",
        "issues_found": "array"
      }
    },
    "VALIDATION_TESTING": {
      "name": "Валидация тестирования",
      "description": "Проверка что приложение готово к завершению",
      "transitions": ["DONE", "ERROR"],
      "timeout_seconds": 600,
      "checkpoint": false,
      "rollback_safe": true,
      "validation_rules": {
        "compiles_without_errors": true,
        "basic_functionality_works": true,
        "critical_crashes_absent": true
      }
    },
    "DONE": {
      "name": "Завершение",
      "description": "Проект завершен, результаты представлены пользователю",
      "transitions": [],
      "timeout_seconds": 300,
      "checkpoint": true,
      "rollback_safe": false,
      "outputs": {
        "final_code": "full_project",
        "documentation": "markdown",
        "statistics": "object"
      }
    },
    "ERROR": {
      "name": "Обработка ошибки",
      "description": "Обработка критичных ошибок с возможностью отката",
      "transitions": ["INIT", "ANALYSIS", "PLANNING", "TESTING", "DONE"],
      "timeout_seconds": 600,
      "checkpoint": true,
      "rollback_safe": true,
      "error_handling": {
        "level": "CRITICAL",
        "recovery_strategy": "rollback_to_checkpoint",
        "user_notification": true,
        "details_logging": true
      }
    }
  },
  "validation_levels": {
    "MUST_HAVE": {
      "priority": 1,
      "action": "block_transition",
      "description": "Процесс не может продолжаться без этого"
    },
    "SHOULD_HAVE": {
      "priority": 2,
      "action": "warn_and_continue",
      "description": "Рекомендуется но не критично"
    },
    "NICE_TO_HAVE": {
      "priority": 3,
      "action": "log_and_continue",
      "description": "Улучшение качества"
    }
  },
  "error_handling_strategy": {
    "levels": {
      "RECOVERABLE": {
        "action": "retry_or_rollback",
        "max_retries": 3,
        "examples": ["invalid_input", "api_timeout", "temporary_failure"]
      },
      "CRITICAL": {
        "action": "stop_and_report",
        "max_retries": 0,
        "examples": ["security_issue", "architecture_violation", "compilation_failure"]
      },
      "WARNING": {
        "action": "log_and_continue",
        "max_retries": 0,
        "examples": ["deprecated_pattern", "performance_concern"]
      }
    }
  },
  "checkpoints": {
    "INIT": {
      "data_to_save": ["mode", "description", "platforms"],
      "rollback_capability": true
    },
    "ANALYSIS": {
      "data_to_save": ["specification", "specification_json", "user_stories"],
      "rollback_capability": true
    },
    "ARCHITECTURE": {
      "data_to_save": ["architecture", "components", "api_contracts", "data_models"],
      "rollback_capability": true
    },
    "PLANNING": {
      "data_to_save": ["developer_count", "tasks", "distribution", "dependencies"],
      "rollback_capability": true
    },
    "INTERACTIVE_DEV": {
      "data_to_save": ["code_snapshots_per_developer", "progress_tracking"],
      "rollback_capability": false,
      "note": "Development phase - no rollback possible"
    },
    "INTEGRATION": {
      "data_to_save": ["integrated_code", "conflict_resolutions"],
      "rollback_capability": true
    },
    "REVIEW": {
      "data_to_save": ["review_report", "issues_found"],
      "rollback_capability": true
    },
    "TESTING": {
      "data_to_save": ["test_results", "final_code"],
      "rollback_capability": true
    }
  }
}
